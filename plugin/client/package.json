{
  "name": "dsh-pet-bridge-ui",
  "version": "0.1.0",
  "private": true,
  "description": "大肥鱼 × DSH 联动 — 管理界面（Web 设置面板）：运行状态 / 活跃度三档 / 总开关 / 免打扰 / 每日预算 / 最近 say / 测试按钮",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19"
  }
}
