{
  "name": "dsh-pet-bridge-ui",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "description": "大肥鱼 × DSH 联动 — 管理界面（Web 设置面板 · 唯一控制台）：运行状态 / 活跃度三档 / 总开关 / 免打扰 / 每日预算 / 桌宠外观与行为 / 快捷查看（余额/天气/音乐/汇总/显示隐藏/回屏内/救急）/ 双击行为 / 皮肤 / 应急控制 / 日志 / 测试",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "README.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.19"
  }
}
