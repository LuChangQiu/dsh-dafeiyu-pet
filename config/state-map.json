    "forbiddenFieldPatterns": ["content", "arguments", "description", "objective", "prompt", "label", "summary", "reason", "cwd", "path", "url", "apiKey", "token(?!s|Usage|Count|Text)"],
    "forbiddenEventParse": ["assistant/message.stream", "request/header", "tool/result.message", "compaction/summary", "compaction/prune", "job.label", "skill.arguments"],
    "note": "subject/source/message 不得进入 state-map/script；只允许枚举 id（如 level/subkind/error category）、计数、时间戳、短 hash"
