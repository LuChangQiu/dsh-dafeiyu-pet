    "sourceHashFormat": "8 位 hex（sha256(sessionId) 前 8 位；不写完整 sessionId）",
    "messageEnum": ["rate_limit", "auth", "timeout", "context", "max_tokens", "unknown", "heartbeat_lost", "plugin_unmounted"],
