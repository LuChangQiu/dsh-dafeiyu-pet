    "styleSource": "say3（现有 wait/normal/inner/report/remind 协议）；script.bubble.style 缺省 auto"
  },
  "fx": ["blink", "love", "shy", "zzz", "sweat", "dizzy", "spin"],
  "expressions": ["idleSmile", "happy", "proud", "pout", "sad", "surprised", "thinking", "sleepy", "crying", "angry", "guilty", "deny", "eating", "guarding"],
  "expressionsMetaOnly": true,
  "expressionRenderer": "noop（v1 无角色帧机器映射；仅面板/FX 名称）",
  "clips": ["idleBase", "idleShift", "idleSettle", "idleStretch", "walk", "eat", "eatSatisfied", "wave", "jump", "land", "dance", "sneak", "sleep", "wake", "turnStop", "drag", "fall"],
  "compositesPlayable": ["think", "waitPeek", "cheer", "errorSequence", "cry", "caught", "lonelySit", "hum", "report", "pat", "tsundere"],
