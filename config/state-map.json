    },
    "session/created": { "target": null, "counters": ["sessions"] },
    "assistant/message": {
      "target": null, "stateUnchanged": true, "counters": [],
      "note": "usage-only：不改变 state；账本归 cost/perf 层；正文禁止解析；显式登记=不计 unknownEventCount"
    },
    "session/disposed": { "target": "session_focus", "when": "was current", "tier": "E2" },
    "goal/change": { "target": null, "oneShot": true, "tier": "E2" },
    "plan/mode": { "target": null, "oneShot": true, "tier": "E2" },
    "team/task": { "target": null, "oneShot": true, "tier": "E2", "debounceMs": 30000 },
    "team/member": { "target": null, "oneShot": true, "tier": "E2", "debounceMs": 30000 },
    "schedule/change": { "target": null, "ambientOnly": true, "perform": false },
    "session/title": { "target": null, "panelOnly": true },
    "working-directory/change": { "target": null, "oneShot": true, "tier": "E2", "cooldownMs": 300000 },
    "agent/status": { "target": "idle", "when": "idle && no open turn", "tier": "E1", "fallbackOnly": true },
    "agent/error": { "target": "error", "subkind": "unknown", "tier": "E0", "cooldownMs": 600000 },
    "cost/warn80": {
      "source": "plugin-internal", "target": "cost", "subkind": "warn80", "tier": "E2",
      "condition": "alerts.cost.enabled && todayUsageRatio>=0.8", "maxPerDay": 1,
      "note": "cost 账本派生，不是 DSH 事件；默认关"
    },
    "cost/limit100": {
      "source": "plugin-internal", "target": "cost", "subkind": "limit100", "tier": "E2",
      "condition": "alerts.cost.enabled && todayUsageRatio>=1.0", "maxPerDay": 1,
      "note": "同上；默认关"
    },
    "timer/sleep": {
      "source": "plugin-internal", "target": "sleep", "subkind": "night", "tier": "E1",
      "condition": "idle>=35min && localTime>=23:30", "s0Wake": true,
      "note": "idle/night 计时器派生；S0 可唤醒；pet 本地 120s 打盹不属此事件"
    }
  },
  "attribution": {
    "nonActiveSessions": { "perform": false, "note": "非当前会话（含子代理/团队/后台）一律 perform:false；只更新计数/情绪/面板" },
    "backgroundEvents": { "perform": false, "counters": ["backgroundCount", "userActiveCount"] },
    "legacyBackgroundAlias": "background → __perform_false__（不是 state，只作标记）"
  },
  "presentationRules": {
    "clipNull": "保持 base（idleBase/当前 clip），只换 expression/bubble",
    "expressionOnly": "仅 expression 层生效；无 role-frame 机器映射（v1 元数据，renderer no-op）",
    "fxAfterMsFrom": "state 进入时刻（不是 action 开始）",
    "fxChancePer": "每次 state 进入独立掷骰",
    "compositePlayable": "仅 manifest 11 playable（note 为元数据空数组，presentation 忽略）",
    "unknownKey": "log + 回退 idleBase/idleSmile",
    "multipleDelays": "取 max，不累加",
    "canonicalKeys": ["clip", "composite", "expression", "fx", "bubbleKind", "bubbleLevel", "gaze", "move"],
    "allowedExtensions": ["clipRate", "holdLast", "fxChance", "fxAfterMs", "bubbleChance", "slow"],
    "deprecatedAliases": { "level": "bubbleLevel", "surface": "presentation.bubbleLevel", "bubble:'none'": "bubbleKind:null,bubbleLevel:null" },
    "validation": {
      "against": "vocabulary * _ALL（ACT_ALL/EXPRESSION_ALL/FX_ALL/BUBBLE_ALL/BUBBLE_LEVEL_ALL）",
      "clip": "∈ ACT_ALL 且必须是 clip（17）",
      "composite": "∈ ACT_ALL 且必须是 playable composite（11；note 排除）",
      "expression": "∈ EXPRESSION_ALL（14；v1 renderer no-op）",
      "fx": "string[]，每项 ∈ FX_ALL（7）",
      "bubblePair": "bubbleKind 与 bubbleLevel 必须成对（同为 null 或同为非 null）",
      "gaze": ["user", "user-cursor", "user-window", "screen-center", "feet", "edge-left", "edge-right", "edge-top", "edge-bottom", "none"],
      "move": ["none", "walk", "back", "to-center", "to-edge", "off"],
      "presentationNull": "允许显式 null（panelOnly/不参与基线比较）；缺省 ≠ null",
      "unknownKey": "FAIL（fixture presentation invalid: unknown key）"
    },
    "defaults": {
      "_global": { "clip": "idleBase", "expression": "idleSmile", "bubbleKind": null, "bubbleLevel": null },
      "_doc": "L4 兜底：state 无 presentation/subkind 时使用（FIXTURE-CLARIFICATION-v3）"
    }
  },
  "presentationResolution": {
    "chainVersion": "v1",
    "chain": [
      "L1 events[type].presentation（可选 overlay，字段级合并）",
      "L2 states[state].subkinds[subkind]（整体替换；条目本身即 presentation，含 presentation 键优先）",
      "L3 states[state].presentation（整体基线）",
      "L4 presentationRules.defaults（state→_global）",
      "L5 null"
    ],
    "rules": {
      "subkindReplacement": "L2 命中即整体替换 L3，不做字段合并",
      "eventFieldMerge": "L1 对 base 字段级合并：出现 key 覆盖、null 抑制、缺省继承",
      "L1Guard": "L1 当前 0 使用；若启用，不得在 PERFORMANCE script 权威下直接设 clip/composite（会构成事件直连动作），仅允许非动作字段（expression/bubbleKind/bubbleLevel/gaze 等）或 PERFORMANCE 层禁用/降级时使用；违反者 fixture/集成 FAIL（reviewer guard）",
      "aliasNormalization": "加载期全局归一化（level→bubbleLevel、surface、bubble-none）；链内不再处理",
      "oneShot": "不在链内：resolve 只出 baseline，renderer 之后叠加 oneShot，结束回 baseline",
      "background": "perform:false 只抑制渲染；解析链照常；fixtures presentation:null=不校验",
      "fixtureCompare": "expect.presentation 子集断言；null=不校验；resolve 后必须过 clip/composite 互斥与 bubble 成对校验",
      "invalid": "log presentation resolution invalid + 回退 idleBase/idleSmile；fixture 侧 FAIL"
    },
    "subkindMetaKeys": ["slow", "afterMs", "bubbleChance", "fxChance", "perform", "petBehavior", "preferredComposite", "preferredPlayable", "covers", "note"],
    "fixtureSources": {
      "L2_subkind": ["F01", "F02", "F03", "F05", "F06", "F07", "F12", "F14", "F35", "F37", "F38", "F39", "F41", "F42", "F46", "F48", "F49", "F53", "F54"],
      "L3_state": ["F04", "F09", "F13", "F15", "F16", "F20", "F22", "F25", "F26", "F29", "F40", "F43", "F44", "F45", "F52"],
      "noAssertion": ["F08", "F10", "F11", "F17", "F18", "F19", "F21", "F23", "F24", "F27", "F28", "F30", "F31", "F32", "F33", "F34", "F36", "F47", "F50", "F51"],
      "L1_overlay": []
