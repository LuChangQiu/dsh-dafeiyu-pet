    "stateMachineKeysCanonical": ["turn", "step", "toolCalls", "toolResults", "approvalsAsked", "approvalsDecided", "retry", "jobs.active", "backgroundCount", "unknownEventCount", "unknownIntentKind", "dispatchCount", "activeSwitchCount"],
    "rule": "state fixtures 的 expect.counters 只允许 stateMachine 表 key；出现 perfCost/panel key → fixture invalid: counter ownership FAIL；绝对期望（回放后累计），tool/approval 按 id 去重；turn/step 为事件次数，与 data.turn 数值无关",
    "initRule": "preconditions.counters 为事件前初始值，深度合并到零态（如 {jobs:{active:1}}）；事件按 given.events 数组顺序回放；expect.counters 为回放后绝对值（v3.1）",
    "dedupe": { "toolCalls": "callId", "toolResults": "callId", "approvalsAsked": "id", "approvalsDecided": "id", "jobs.active": "jobId", "backgroundCount": "session" }
  },
  "fixtureSchema": {
    "version": 3,
    "addendum": "v3.1",
    "count": {"state": 54, "performance": 32},
    "files": ["docs/state-fixtures.draft.jsonl", "docs/performance-fixtures.draft.jsonl"],
    "requiredPreconditions": ["state"],
    "preconditionsRule": "schema 3 起 given.preconditions.state 必填（无先前状态显式写 idle）；preconditions.counters 承载初始计数（不再接受顶层点号 key）",
    "requiredExpect": ["state"],
    "noRouteEvents": ["assistant/message", "session/title", "request/context"],
    "eventClasses": {
      "state": ["turn/start", "step/start", "tool/call", "tool/result", "approval/asked", "approval/decided", "user-questions/request", "userQuestions.settled", "compaction/start", "compaction/end", "job/registered", "job/settled", "model/selection", "session/disposed", "turn/end"],
      "pureOneShot": ["goal/change", "plan/mode", "team/task", "team/member", "working-directory/change"],
      "panelOnly": ["request/context", "schedule/change", "session/title", "assistant/message"],
      "internal": ["cost/warn80", "cost/limit100", "timer/sleep"]
    },
    "oneShotRule": {
      "stateExit": ["approval/decided", "userQuestions.settled"],
      "pureOneShot": ["goal/change", "plan/mode", "team/task", "team/member", "working-directory/change"],
      "rule": "state-exit 改 state（stateUnchanged:false）；pure oneShot state 不变（state 回显当前值，stateUnchanged:true）；每条 fixture 必须有 expect.state"
    },
    "clarification": ["docs/FIXTURE-CLARIFICATION-v1.md", "docs/FIXTURE-CLARIFICATION-v2.md", "docs/FIXTURE-CLARIFICATION-v3.md", "docs/FIXTURE-CLARIFICATION-v3.1.md"]
  },
  "oneShots": {
