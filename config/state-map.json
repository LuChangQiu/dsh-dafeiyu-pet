  "events": {
    "turn/start": { "target": "thinking", "subkind": "turn", "tier": "E1", "debounceMs": 300 },
    "step/start": { "target": "thinking", "subkind": "step", "tier": "E1", "debounceMs": 300 },
    "user/message": {
      "target": "thinking", "subkind": "user", "when": "source.kind==='user' && session===current", "tier": "E1",
      "activeSwitch": {
        "target": "session_focus", "subkind": "switch", "debounceMs": 2500,
        "trigger": { "isHuman": "event.source.kind==='user'", "sessionChanged": "event.data.sessionId !== preconditions.currentSessionId" },
        "sessionChangedComputed": true,
        "condition": "event.source.kind==='user' && event.data.sessionId !== preconditions.currentSessionId",
        "deactivatePrevious": "perform:false",
        "counter": "activeSwitchCount",
        "note": "sessionChanged 由 state-machine 计算，不是 DSH 字段；未来事件带同名也忽略"
      }
    },
    "tool/call": { "target": "tool", "subkindFrom": "toolType", "tier": "E1", "debounceMs": 300 },
    "tool/result": { "target": "thinking", "subkind": "step", "when": "all calls settled", "tier": "E1" },
    "approval/asked": { "target": "approval", "subkindFrom": "toolTypeOf(toolName)", "tier": "E0", "cooldownMs": 15000 },
    "approval/decided": { "target": "thinking", "subkind": "step", "tier": "E1", "cooldownMs": 15000, "oneShot": "approval_return" },
    "user-questions/request": {
      "target": "waiting_input", "tier": "E0", "approvalPrecedence": true, "observeOnly": true,
      "subkindRule": {
        "precedence": [
          "event.data.intent?.kind",
          "event.data.questionKind",
          "questions.find(q=>q.intent?.kind)?.intent.kind",
          "questions.some(q=>q.multiSelect===true) ? 'multi' : 'choice'",
          "questions.length===0 ? 'choice'"
        ],
        "map": { "plan-review": "plan_review", "freeform": "freeform", "choice": "choice", "multi": "multi" },
        "unknown": "choice",
        "unknownCounter": "unknownIntentKind"
      }
    },
    "userQuestions.settled": { "target": "thinking", "subkind": "step", "tier": "E1", "debounceMs": 500 },
    "agent/request-error": {
      "target": "error", "tier": "E0", "cooldownMs": 600000, "subkindFrom": "failure.code",
      "codeMap": {
        "RATE_LIMIT": "rate_limit", "RATE": "rate_limit", "429": "rate_limit",
        "AUTH": "auth", "INVALID_CREDENTIAL": "auth",
        "TIMEOUT": "timeout", "NETWORK": "timeout", "ECONNRESET": "timeout", "ETIMEDOUT": "timeout",
        "CONTEXT_WINDOW_EXCEEDED": "context", "MAX_TOKENS": "max_tokens", "MAX-TOKENS": "max_tokens",
        "default": "unknown"
      }
    },
    "llm/retry": { "target": null, "escalate": { "count": 3, "windowMs": 60000, "then": "error/rate_limit" }, "tier": "E1" },
    "turn/end": {
      "target": null, "targetFromReasonMap": true, "reasonPriority": "reasonMap-only",
      "subkindFrom": "reason.kind", "tier": "E0|E2",
      "note": "最终 state 只由 reasonMap[reason.kind].state 决定；不得用上一状态/默认 thinking 覆盖；unknown→incomplete；completed+reportDue→subkind report",
      "reportRule": { "when": "reason.kind==='completed' && preconditions.reportDue===true", "subkind": "report" },
      "reasonMap": {
        "completed": { "state": "done", "subkind": "completed", "bubbleLevel": "S1", "perform": true },
        "error": { "state": "error", "subkind": "unknown", "bubbleLevel": "S1", "perform": true },
        "aborted": { "state": "done", "subkind": "aborted", "bubbleLevel": "S2", "perform": "bubble:false" },
        "max-tokens": { "state": "error", "subkind": "max_tokens", "bubbleLevel": "S1", "perform": true },
        "blocked": { "state": "done", "subkind": "blocked", "bubbleLevel": "S2", "perform": "panelOnly" },
        "incomplete": { "state": "done", "subkind": "incomplete", "bubbleLevel": "S3", "perform": "panelOnly", "covers": ["interrupted", "forked", "legacy"] }
      }
    },
    "compaction/start": { "target": "compaction", "subkind": "start", "tier": "E1" },
    "compaction/end": { "target": "thinking", "subkind": "step", "tier": "E1" },
    "job/registered": { "kind": "state", "target": "job", "subkind": "started", "tier": "E1", "cooldownMs": 180000 },
    "job/settled": {
      "kind": "state", "target": "job", "subkindFrom": "status", "tier": "E1", "debounceMs": 30000,
      "exitRule": "remaining=jobs.active-1; remaining>0 ? job(status) : thinking/step",
      "exitState": "thinking", "exitSubkind": "step"
    },
    "model/selection": { "kind": "state", "target": "model_switch", "subkind": "selection", "tier": "E2", "cooldownMs": 60000 },
    "request/context": {
      "kind": "panelOnly", "target": null, "stateUnchanged": true, "panelOnly": true,
