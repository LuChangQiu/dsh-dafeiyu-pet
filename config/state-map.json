  "renderRules": {
    "greybox": { "config": "render.greybox=true", "behavior": "关闭角色图，仅占位几何+姿态（V23 验收）", "colors": { "base": "gray", "action": "blue+key", "expression": "yellow", "bubble": "white+kind", "fx": "purple", "gaze": "arrow" } }
  },
  "delays": { "policy": "max", "pluginDebounceOnce": true, "petOnlyCrossfadeMs": [80, 150] },
  "privacy": {
