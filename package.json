  "type": "module",
  "version": "0.26.0",
  "name": "dsh-dafeiyu-pet",
  "scripts": {
    "verify:detached": "node scripts/harness/plugin-harness.mjs",
    "test:whale-wiring": "node --test plugin/server/test/whale-acts.test.mjs plugin/server/test/cf1-wiring-contract.test.mjs",
    "test:llm-lines": "node plugin/server/test/llm-lines.test.mjs && node plugin/server/test/speech-requests.test.mjs && node plugin/server/test/action-director.test.mjs && node plugin/server/test/llm-lines-mock.test.mjs",
    "test:whale-pipe": "node --test plugin/server/test/cf1-pipe.test.mjs",
    "lint": "node scripts/lint.mjs && prettier --check \"plugin/**/*.js\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"plugin/**/*.js\" \"scripts/**/*.mjs\"",
    "nodecheck": "node scripts/lint.mjs"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "@eslint/js": "^9.14.0",
    "prettier": "^3.3.3"
  },
  "description": "DSH 大肥鱼桌宠联动（单仓产品：pet/ + plugin/server + plugin/client）",
  "private": true
}
